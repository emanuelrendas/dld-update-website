{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "emanuelrendas.com" }],
      "destination": "https://www.emanuelrendas.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "dashboard.emanuelrendas.com" }],
      "destination": "/api?__path=/dashboard"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "dashboard.emanuelrendas.com" }],
      "destination": "/api?__path=/dashboard"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "api.emanuelrendas.com" }],
      "destination": "/api?__path=/$1"
    },
    {
      "source": "/dashboard",
      "destination": "/api?__path=/dashboard"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__path=/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api?__path=/$1"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    }
  ]
}
